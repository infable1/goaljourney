{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.4/journey.json",
  "title": "Journey",
  "description": "A living route from the current state to the desired outcome. Grammar: Region > Milestone > Node (task | challenge | ai_checkpoint | decision_point | verification). Dependencies live on nodes (`depends_on`) — a single source of truth, validated as a DAG. Near-term nodes are detailed (`detail_level: full` with a Task); later nodes stay outlines until their region opens (progressive disclosure, prevents overplanning). Levels and achievements are goal-specific and tied to verified progress, never to app activity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["regions", "milestones", "nodes"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/id" },
    "goal_id": { "$ref": "common.json#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "strategy_summary": { "$ref": "common.json#/$defs/text" },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weekly_hours_planned": { "type": "number", "minimum": 0, "maximum": 100 },
        "horizon_weeks": { "type": "integer", "minimum": 1, "maximum": 260 },
        "notes": { "$ref": "common.json#/$defs/short_text" }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/region" }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/milestone" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/node" }
    },
    "assumptions": { "$ref": "common.json#/$defs/text_list" },
    "levels": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/level" }
    },
    "achievements": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/achievement" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/id" },
        "title": { "$ref": "common.json#/$defs/short_text" },
        "description": { "$ref": "common.json#/$defs/text" },
        "order": { "type": "integer", "minimum": 1, "maximum": 20 },
        "status": { "type": "string", "enum": ["locked", "active", "completed"] }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "region_id", "success_criteria"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/id" },
        "title": { "$ref": "common.json#/$defs/short_text" },
        "region_id": { "$ref": "common.json#/$defs/id" },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "common.json#/$defs/short_text" }
        },
        "target_date": {
          "oneOf": [ { "$ref": "common.json#/$defs/date" }, { "type": "null" } ]
        },
        "status": { "type": "string", "enum": ["pending", "achieved", "verified", "dropped"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "region_id", "status"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/id" },
        "type": {
          "type": "string",
          "enum": ["task", "challenge", "ai_checkpoint", "decision_point", "verification"]
        },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "description": { "$ref": "common.json#/$defs/text" },
        "region_id": { "$ref": "common.json#/$defs/id" },
        "milestone_id": { "$ref": "common.json#/$defs/id" },
        "status": {
          "type": "string",
          "enum": ["locked", "available", "in_progress", "completed", "verified", "skipped", "removed"]
        },
        "detail_level": { "type": "string", "enum": ["full", "outline"] },
        "depends_on": { "$ref": "common.json#/$defs/id_list" },
        "estimated_duration_minutes": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "priority": { "type": "string", "enum": ["critical", "high", "normal", "optional"] },
        "due_date": {
          "oneOf": [ { "$ref": "common.json#/$defs/date" }, { "type": "null" } ]
        },
        "created_by": { "type": "string", "enum": ["ai", "user"] },
        "task": { "$ref": "task.json" },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "options"],
          "properties": {
            "question": { "$ref": "common.json#/$defs/short_text" },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "common.json#/$defs/short_text" }
            }
          }
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "title", "unlock_criteria"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 10 },
        "title": { "$ref": "common.json#/$defs/short_text" },
        "meaning": { "$ref": "common.json#/$defs/short_text" },
        "unlock_milestone_id": { "$ref": "common.json#/$defs/id" },
        "unlock_criteria": { "$ref": "common.json#/$defs/short_text" }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "unlock"],
      "properties": {
        "id": { "$ref": "common.json#/$defs/id" },
        "title": { "$ref": "common.json#/$defs/short_text" },
        "description": { "$ref": "common.json#/$defs/short_text" },
        "unlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "description": "Achievements represent real progress. There is intentionally no login/streak/app-open type.",
              "type": "string",
              "enum": [
                "first_verified_task", "first_real_world_result", "milestone_verified",
                "region_completed", "capability_demonstrated", "goal_completed", "goal_exceeded"
              ]
            },
            "ref": { "$ref": "common.json#/$defs/id" }
          }
        }
      }
    }
  }
}
