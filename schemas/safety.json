{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.1/safety.json",
  "title": "Operation output: safety_classification",
  "description": "Safety layer. The navigator never acts as a doctor, lawyer, therapist or financial adviser; for sensitive goals it reframes its role as planning/organisation/research support and refers to professionals when needed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "response_language", "message_to_user", "category", "domains", "ai_role", "professional_referral", "boundaries", "allowed_support", "proceed_with_journey"],
  "properties": {
    "type": { "const": "safety_classification" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "category": { "$ref": "common.json#/$defs/safety_category" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["medical", "mental_health", "financial", "legal", "dangerous_activity", "harm_to_others", "illegal_activity", "privacy", "none"]
      }
    },
    "ai_role": { "type": "string", "enum": ["full_navigator", "planning_support_only", "declined"] },
    "professional_referral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needed"],
      "properties": {
        "needed": { "type": "boolean" },
        "professional_type": { "$ref": "common.json#/$defs/short_text" },
        "urgency": { "type": "string", "enum": ["routine", "soon", "urgent", "emergency"] }
      }
    },
    "boundaries": {
      "description": "What the navigator will not do for this goal.",
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "common.json#/$defs/short_text" }
    },
    "allowed_support": {
      "description": "What the navigator can still help with.",
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "common.json#/$defs/short_text" }
    },
    "proceed_with_journey": { "type": "boolean" },
    "safer_reframing": {
      "description": "A safer version of the goal the user could choose instead.",
      "$ref": "common.json#/$defs/text"
    }
  }
}
