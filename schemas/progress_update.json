{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.4/progress_update.json",
  "title": "Operation output: progress_update (levels & achievements)",
  "description": "Goal progress, goal-specific level and achievements are derived from verified progress only. App activity (streaks, logins) never changes level or unlocks achievements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "response_language", "message_to_user", "goal_progress", "level", "achievements_unlocked"],
  "properties": {
    "type": { "const": "progress_update" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "goal_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "basis"],
      "properties": {
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "basis": { "$ref": "common.json#/$defs/short_text" },
        "verified_milestones": { "$ref": "common.json#/$defs/id_list" },
        "remaining_milestones": { "$ref": "common.json#/$defs/id_list" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_index", "current_title", "changed", "reason", "based_on"],
      "properties": {
        "current_index": { "type": "integer", "minimum": 0, "maximum": 10 },
        "current_title": { "$ref": "common.json#/$defs/short_text" },
        "changed": { "type": "boolean" },
        "previous_index": { "type": "integer", "minimum": 0, "maximum": 10 },
        "reason": { "$ref": "common.json#/$defs/short_text" },
        "based_on": { "$ref": "common.json#/$defs/id_list" }
      }
    },
    "achievements_unlocked": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["achievement_id", "title", "reason", "evidence_refs"],
        "properties": {
          "achievement_id": { "$ref": "common.json#/$defs/id" },
          "title": { "$ref": "common.json#/$defs/short_text" },
          "reason": { "$ref": "common.json#/$defs/short_text" },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "$ref": "common.json#/$defs/id" }
          }
        }
      }
    },
    "not_awarded": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "reason"],
        "properties": {
          "candidate": { "$ref": "common.json#/$defs/short_text" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "suggested_next_action": { "$ref": "common.json#/$defs/short_text" }
  }
}
