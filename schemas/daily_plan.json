{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.4/daily_plan.json",
  "title": "Operation output: daily_plan (Type J)",
  "description": "The most useful next action(s) for today. Few tasks, within the time available, dependencies satisfied. The user must always know what to do next.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "response_language", "message_to_user", "available_minutes", "recommended_tasks", "total_minutes", "next_action"],
  "properties": {
    "type": { "const": "daily_plan" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "available_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "recommended_tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "reason", "estimated_duration_minutes"],
        "properties": {
          "task_id": { "$ref": "common.json#/$defs/id" },
          "reason": { "$ref": "common.json#/$defs/short_text" },
          "estimated_duration_minutes": { "$ref": "common.json#/$defs/minutes" },
          "scope_note": {
            "description": "When only part of the task fits today: which part.",
            "$ref": "common.json#/$defs/short_text"
          }
        }
      }
    },
    "total_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "deferred": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "reason"],
        "properties": {
          "task_id": { "$ref": "common.json#/$defs/id" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "next_action": { "$ref": "common.json#/$defs/short_text" },
    "facts_used": { "$ref": "common.json#/$defs/facts_used" }
  }
}
