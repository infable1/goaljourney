{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.0/route_adaptation.json",
  "title": "Operation output: route_adaptation (Types H, K)",
  "description": "Change set against the current journey. Completed/verified progress is preserved unless explicitly justified. Major changes require user confirmation. Every change is explained in decision_summary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "response_language", "message_to_user", "trigger", "change_level", "requires_user_confirmation", "removed_nodes", "added_nodes", "modified_nodes", "modified_deadlines", "preserved_progress", "decision_summary"],
  "properties": {
    "type": { "const": "route_adaptation" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "$ref": "common.json#/$defs/change_trigger" },
        "description": { "$ref": "common.json#/$defs/short_text" }
      }
    },
    "change_level": { "type": "string", "enum": ["none", "minor", "moderate", "major"] },
    "requires_user_confirmation": { "type": "boolean" },
    "removed_nodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "reason"],
        "properties": {
          "node_id": { "$ref": "common.json#/$defs/id" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "added_nodes": {
      "type": "array",
      "maxItems": 15,
      "items": { "$ref": "journey.json#/$defs/node" }
    },
    "modified_nodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "changes", "reason"],
        "properties": {
          "node_id": { "$ref": "common.json#/$defs/id" },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "to"],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": ["title", "description", "estimated_duration_minutes", "depends_on", "due_date", "priority", "status", "milestone_id", "region_id", "verification_protocol", "type"]
                },
                "from": {},
                "to": {}
              }
            }
          },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "modified_milestones": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["milestone_id", "change", "reason"],
        "properties": {
          "milestone_id": { "$ref": "common.json#/$defs/id" },
          "change": { "type": "string", "enum": ["added", "removed", "renamed", "criteria_changed", "moved"] },
          "new_title": { "$ref": "common.json#/$defs/short_text" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "modified_deadlines": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "target_id", "to", "reason"],
        "properties": {
          "target": { "type": "string", "enum": ["goal", "milestone", "node"] },
          "target_id": { "$ref": "common.json#/$defs/id" },
          "from": { "oneOf": [ { "$ref": "common.json#/$defs/date" }, { "type": "null" } ] },
          "to": { "oneOf": [ { "$ref": "common.json#/$defs/date" }, { "type": "null" } ] },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "new_weekly_hours_planned": { "type": "number", "minimum": 0, "maximum": 100 },
    "preserved_progress": {
      "description": "Completed/verified node ids that remain valid after the change.",
      "$ref": "common.json#/$defs/id_list"
    },
    "user_options": {
      "description": "Alternatives the user can pick instead of the proposed change.",
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "common.json#/$defs/short_text" }
    },
    "external_claims": { "$ref": "common.json#/$defs/external_claims" },
    "decision_summary": { "$ref": "decision_summary.json" }
  }
}
