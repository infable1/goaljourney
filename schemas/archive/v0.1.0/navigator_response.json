{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.0/navigator_response.json",
  "title": "Operation output: navigator_response (Type I)",
  "description": "Contextual reply to a user request about the goal/journey. The navigator advises, may push back with reasons, and proposes changes the user confirms. Requests unrelated to the goal are politely redirected (in_scope=false), not fulfilled.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "response_language", "message_to_user", "intent", "in_scope", "proposed_changes", "requires_user_confirmation"],
  "properties": {
    "type": { "const": "navigator_response" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "intent": {
      "type": "string",
      "enum": [
        "explain_task", "decline_task", "request_alternative", "explain_route_change",
        "limited_time", "reschedule", "remove_milestone", "modify_task", "create_task",
        "skip_section", "change_deadline", "progress_question", "emotional_support_boundary",
        "off_topic", "other"
      ]
    },
    "in_scope": { "type": "boolean" },
    "proposed_changes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "description"],
        "properties": {
          "action": { "type": "string", "enum": ["add", "remove", "modify", "reschedule", "replace", "skip", "split"] },
          "target_id": { "$ref": "common.json#/$defs/id" },
          "description": { "$ref": "common.json#/$defs/text" }
        }
      }
    },
    "requires_user_confirmation": { "type": "boolean" },
    "risks": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "common.json#/$defs/short_text" }
    },
    "suggested_next_action": { "$ref": "common.json#/$defs/short_text" },
    "external_claims": { "$ref": "common.json#/$defs/external_claims" },
    "decision_summary": {
      "oneOf": [ { "$ref": "decision_summary.json" }, { "type": "null" } ]
    }
  }
}
