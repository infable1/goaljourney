{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.2/route_adaptation.json",
  "title": "Operation output: route_adaptation (Types H, K)",
  "description": "Change set against the current journey. Completed/verified progress is preserved unless explicitly justified. Major changes require user confirmation. Every change is explained in decision_summary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "response_language", "message_to_user", "trigger", "change_level", "requires_user_confirmation", "removed_nodes", "added_nodes", "modified_nodes", "modified_deadlines", "preserved_progress", "decision_summary"],
  "properties": {
    "type": { "const": "route_adaptation" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "$ref": "common.json#/$defs/change_trigger" },
        "description": { "$ref": "common.json#/$defs/short_text" }
      }
    },
    "change_level": { "type": "string", "enum": ["none", "minor", "moderate", "major"] },
    "requires_user_confirmation": { "type": "boolean" },
    "removed_nodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "reason"],
        "properties": {
          "node_id": { "$ref": "common.json#/$defs/id" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "added_nodes": {
      "type": "array",
      "maxItems": 15,
      "items": { "$ref": "journey.json#/$defs/node" }
    },
    "modified_nodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "changes", "reason"],
        "properties": {
          "node_id": { "$ref": "common.json#/$defs/id" },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "to"],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": ["title", "description", "estimated_duration_minutes", "depends_on", "due_date", "priority", "status", "milestone_id", "region_id", "verification_protocol", "type"]
                },
                "from": {},
                "to": {}
              }
            }
          },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "modified_milestones": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["milestone_id", "change", "reason"],
        "properties": {
          "milestone_id": { "$ref": "common.json#/$defs/id" },
          "change": { "type": "string", "enum": ["added", "removed", "renamed", "criteria_changed", "moved"] },
          "new_title": { "$ref": "common.json#/$defs/short_text" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "modified_deadlines": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "target_id", "to", "reason", "autonomy", "state"],
        "properties": {
          "target": { "type": "string", "enum": ["goal", "milestone", "node"] },
          "target_id": { "$ref": "common.json#/$defs/id" },
          "from": { "oneOf": [ { "$ref": "common.json#/$defs/date" }, { "type": "null" } ] },
          "to": { "oneOf": [ { "$ref": "common.json#/$defs/date" }, { "type": "null" } ] },
          "reason": { "$ref": "common.json#/$defs/short_text" },
          "autonomy": {
            "description": "POL-C: node -> auto (adapt when justified); milestone -> adapt_with_summary (named in decision_summary); goal -> confirm_required (only proposed).",
            "type": "string", "enum": ["auto", "adapt_with_summary", "confirm_required"]
          },
          "state": {
            "description": "applied = in effect now; proposed = takes effect only after the user confirms (always the case when requires_user_confirmation is true).",
            "type": "string", "enum": ["applied", "proposed"]
          }
        }
      }
    },
    "new_weekly_hours_planned": {
      "description": "Steady weekly pace after this change (temporary deviations go into workload.pace_phases).",
      "type": "number", "minimum": 0, "maximum": 100
    },
    "workload": {
      "description": "Arithmetic behind a time-related change, recomputed by the validator from node estimates (POL-C). Required when the trigger is less_time or more_time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["weekly_hours", "remaining_minutes_before", "remaining_minutes_after", "horizon", "weeks_needed", "weeks_available", "fits"],
      "properties": {
        "weekly_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "pace_phases": {
          "description": "Temporary pace between two dates (inclusive), e.g. a vacation; outside them weekly_hours applies.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "weekly_hours"],
            "properties": {
              "from": { "$ref": "common.json#/$defs/date" },
              "to": { "$ref": "common.json#/$defs/date" },
              "weekly_hours": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "remaining_minutes_before": { "type": "integer", "minimum": 0, "description": "Unfinished estimated work in the input journey." },
        "remaining_minutes_after": { "type": "integer", "minimum": 0, "description": "Unfinished estimated work after this change." },
        "unestimated_node_ids": { "$ref": "common.json#/$defs/id_list" },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "target_id", "date"],
          "properties": {
            "target": { "type": "string", "enum": ["goal", "milestone"] },
            "target_id": { "$ref": "common.json#/$defs/id" },
            "date": { "$ref": "common.json#/$defs/date" }
          }
        },
        "weeks_needed": { "type": "number", "minimum": 0 },
        "weeks_available": { "type": "number" },
        "fits": { "type": "boolean" }
      }
    },
    "invalidated_progress": {
      "description": "Completed/verified nodes whose result no longer applies (e.g. an agreement that fell through). They stay in history; they are neither preserved nor silently discarded.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "reason"],
        "properties": {
          "node_id": { "$ref": "common.json#/$defs/id" },
          "reason": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "facts_used": { "$ref": "common.json#/$defs/facts_used" },
    "preserved_progress": {
      "description": "Completed/verified node ids that remain valid after the change.",
      "$ref": "common.json#/$defs/id_list"
    },
    "user_options": {
      "description": "Alternatives the user can pick instead of the proposed change.",
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "common.json#/$defs/short_text" }
    },
    "external_claims": { "$ref": "common.json#/$defs/external_claims" },
    "decision_summary": { "$ref": "decision_summary.json" }
  }
}
