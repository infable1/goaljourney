{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goaljourney.invalid/v0.1.1/web_research_decision.json",
  "title": "Operation output: web_research_decision (Type N)",
  "description": "Decide whether current external facts must be verified before planning. Research is required only when time-sensitive, location-specific, legal, pricing, schedule, exam or product facts materially affect the route. Unsupported claims (hearsay, model memory) are listed and never treated as facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "needs_research", "reason_categories", "rationale", "facts_to_verify", "queries", "unsupported_claims", "can_proceed_without_research"],
  "properties": {
    "type": { "const": "web_research_decision" },
    "response_language": { "$ref": "common.json#/$defs/language" },
    "message_to_user": { "$ref": "common.json#/$defs/message" },
    "needs_research": { "type": "boolean" },
    "reason_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["laws_regulations", "current_prices", "schedules", "exam_requirements", "product_specifications", "location_specific", "time_sensitive", "none"]
      }
    },
    "rationale": { "$ref": "common.json#/$defs/text" },
    "facts_to_verify": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "why_it_matters"],
        "properties": {
          "fact": { "$ref": "common.json#/$defs/short_text" },
          "why_it_matters": { "$ref": "common.json#/$defs/short_text" },
          "affects": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "queries": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "common.json#/$defs/short_text" }
    },
    "unsupported_claims": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "origin", "handling"],
        "properties": {
          "claim": { "$ref": "common.json#/$defs/short_text" },
          "origin": { "type": "string", "enum": ["user_hearsay", "model_memory", "outdated_source", "unknown"] },
          "handling": { "$ref": "common.json#/$defs/short_text" }
        }
      }
    },
    "can_proceed_without_research": { "type": "boolean" },
    "interim_guidance": { "$ref": "common.json#/$defs/short_text" }
  }
}
