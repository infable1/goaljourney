# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Only the provider selected in configs/generation.yaml (or via --provider) is required.

# Anthropic Messages API
ANTHROPIC_API_KEY=

# Any OpenAI-compatible chat-completions endpoint (OpenAI, vLLM, Ollama, OpenRouter, ...)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
